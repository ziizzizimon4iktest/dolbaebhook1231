-- HITBOX
local function expandHitboxes()
    for _,p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character then
            local hrp = p.Character:FindFirstChild("HumanoidRootPart")
            if hrp then pcall(function() hrp.Size=Vector3.new(hitboxSize,hitboxSize,hitboxSize); hrp.Transparency=0.3; hrp.Color=hitboxColor; hrp.Material=Enum.Material.Neon end) end
        end
    end
end
local function resetHitboxes()
    for _,p in ipairs(Players:GetPlayers()) do
        if p.Character then local hrp=p.Character:FindFirstChild("HumanoidRootPart")
            if hrp then pcall(function() hrp.Size=Vector3.new(2,2,1); hrp.Transparency=1; hrp.Color=Color3.new(1,1,1); hrp.Material=Enum.Material.Plastic end) end
        end
    end
end
local function enableHitbox() hitboxEnabled=true; if hitboxConn then hitboxConn:Disconnect() end; hitboxConn=RunService.Heartbeat:Connect(expandHitboxes) end
local function disableHitbox() hitboxEnabled=false; if hitboxConn then hitboxConn:Disconnect(); hitboxConn=nil end; resetHitboxes() end

-- ESP (NAME + BOX + HEALTH BAR)
local espList = {}
local function espLoop()
    for _, item in ipairs(espList) do
        pcall(function() item.name:Remove() end)
        pcall(function() item.box:Remove() end)
        pcall(function() item.hpBg:Remove() end)
        pcall(function() item.hpBar:Remove() end)
    end
    espList = {}
    for _, p in ipairs(Players:GetPlayers()) do
        if p == LocalPlayer then continue end
        if not p.Character then continue end
        local head = p.Character:FindFirstChild("Head")
        if not head then continue end
        
        local item = {player = p}
        
        if nameEspEnabled then
            local txt = Drawing.new("Text")
            txt.Visible = true; txt.Color = nameEspColor; txt.Size = 14; txt.Center = true; txt.Outline = true; txt.OutlineColor = Color3.new(0,0,0)
            item.name = txt
        end
        
        if boxEspEnabled then
            local box = Drawing.new("Square")
            box.Visible = true; box.Color = boxEspColor; box.Thickness = 1; box.Filled = false
            item.box = box
        end
        
        if healthBarEnabled then
            local hpBg = Drawing.new("Line")
            hpBg.Visible = true; hpBg.Color = Color3.new(0.15,0.15,0.15); hpBg.Thickness = 3
            item.hpBg = hpBg
            local hpBar = Drawing.new("Line")
            hpBar.Visible = true; hpBar.Color = Color3.new(0,1,0); hpBar.Thickness = 1
            item.hpBar = hpBar
        end
        
        table.insert(espList, item)
    end
end
local function espRender()
    local myPos = Camera.CFrame.Position
    for _, item in ipairs(espList) do
        pcall(function()
            local p = item.player
            if p == LocalPlayer then
                if item.name then item.name.Visible = false end
                if item.box then item.box.Visible = false end
                if item.hpBg then item.hpBg.Visible = false; item.hpBar.Visible = false end
                return
            end
            local char = p.Character
            if not char then
                if item.name then item.name.Visible = false end
                if item.box then item.box.Visible = false end
                if item.hpBg then item.hpBg.Visible = false; item.hpBar.Visible = false end
                return
            end
            local head = char:FindFirstChild("Head")
            local hrp = char:FindFirstChild("HumanoidRootPart")
            local hum = char:FindFirstChildOfClass("Humanoid")
            if not head or not hrp or not hum then
                if item.name then item.name.Visible = false end
                if item.box then item.box.Visible = false end
                if item.hpBg then item.hpBg.Visible = false; item.hpBar.Visible = false end
                return
            end
            local topPoint = head.Position + Vector3.new(0, 1.5, 0)
            local bottomPoint = hrp.Position - Vector3.new(0, 3.5, 0)
            local topPos, topOnScreen = Camera:WorldToViewportPoint(topPoint)
            local bottomPos = Camera:WorldToViewportPoint(bottomPoint)
            if not topOnScreen then
                if item.name then item.name.Visible = false end
                if item.box then item.box.Visible = false end
                if item.hpBg then item.hpBg.Visible = false; item.hpBar.Visible = false end
                return
            end
            local dist = math.floor((myPos - head.Position).Magnitude)
            if dist > 1000 then
                if item.name then item.name.Visible = false end
                if item.box then item.box.Visible = false end
                if item.hpBg then item.hpBg.Visible = false; item.hpBar.Visible = false end
                return
            end
            local boxHeight = math.abs(topPos.Y - bottomPos.Y)
            local boxWidth = boxHeight * 0.55
            local boxLeft = topPos.X - boxWidth/2
            local boxTop = topPos.Y
            
            if item.name then
                item.name.Visible = true; item.name.Color = nameEspColor
                item.name.Text = p.DisplayName .. " [" .. dist .. "m]"; item.name.Position = Vector2.new(topPos.X, topPos.Y - 20)
            end
            if item.box then
                item.box.Visible = true; item.box.Color = boxEspColor
                item.box.Position = Vector2.new(boxLeft, boxTop); item.box.Size = Vector2.new(boxWidth, boxHeight)
            end
            if item.hpBar and item.hpBg then
                local hpPct = hum.Health / hum.MaxHealth; local barX = boxLeft - 6; local barTopY = boxTop; local barBottomY = boxTop + boxHeight
                item.hpBg.Visible = true; item.hpBg.From = Vector2.new(barX, barTopY); item.hpBg.To = Vector2.new(barX, barBottomY)
                local healthY = barTopY + (barBottomY - barTopY) * (1 - hpPct)
                item.hpBar.Visible = true; item.hpBar.From = Vector2.new(barX, healthY); item.hpBar.To = Vector2.new(barX, barBottomY)
                item.hpBar.Color = hpPct > 0.5 and Color3.new(0,1,0) or (hpPct > 0.25 and Color3.new(1,1,0) or Color3.new(1,0,0))
            end
        end)
    end
end
local function enableESP() espEnabled=true; if espConn then espConn:Disconnect() end; espLoop(); espConn=RunService.RenderStepped:Connect(function() espLoop(); espRender() end) end
local function disableESP() espEnabled=false; if espConn then espConn:Disconnect(); espConn=nil end; for _, item in ipairs(espList) do pcall(function() item.name:Remove() end); pcall(function() item.box:Remove() end); pcall(function() item.hpBg:Remove() end); pcall(function() item.hpBar:Remove() end) end; espList={} end

