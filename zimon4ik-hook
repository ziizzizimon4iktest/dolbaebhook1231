    print("✅ Hitbox включён, размер:", _G.hitboxSize)
end

local function disableHitbox()
    if not _G.hitboxEnabled then return end
    _G.hitboxEnabled = false
    if hitboxConn then 
        hitboxConn:Disconnect()
        hitboxConn = nil
    end
    resetHitboxes()
    print("✅ Hitbox выключен")
end

