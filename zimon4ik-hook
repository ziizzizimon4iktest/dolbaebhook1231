local function toggleAutojump()
    _G.autojumpEnabled = not _G.autojumpEnabled
    if _G.autojumpEnabled then
        print("✅ AutoJump ВКЛЮЧЁН (C)")
        if autojumpThread then pcall(function() autojumpThread:Disconnect() end); autojumpThread = nil end
        autojumpThread = RunService.Heartbeat:Connect(function()
            if not _G.autojumpEnabled then return end
            pcall(function()
                local char = LocalPlayer.Character
                if char then
                    local hum = char:FindFirstChildOfClass("Humanoid")
                    if hum and hum.PlatformStand == false then
                        if hum.FloorMaterial ~= Enum.Material.Air then
                            hum.Jump = true
                        end
                    end
                end
            end)
        end)
    else
        print("❌ AutoJump ВЫКЛЮЧЁН")
        if autojumpThread then pcall(function() autojumpThread:Disconnect() end); autojumpThread = nil end
    end
end

addConnection(UserInputService.InputBegan:Connect(function(input, processed)
    if processed then return end
    if input.UserInputType == Enum.UserInputType.Keyboard then
        if input.KeyCode.Name == "C" then
            toggleAutojump()
        end
    end
end))

