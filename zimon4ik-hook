local hitboxMethods = {
    function(hrp)
        hrp.Size = Vector3.new(_G.hitboxSize, _G.hitboxSize, _G.hitboxSize)
        return true
    end,
    function(hrp)
        if hrp:GetNetworkOwner() ~= LocalPlayer then
            hrp:SetNetworkOwner(LocalPlayer)
            task.wait(0.05)
        end
        hrp.Size = Vector3.new(_G.hitboxSize, _G.hitboxSize, _G.hitboxSize)
        return true
    end,
    function(hrp)
        local att = hrp:FindFirstChild("HitboxAttachment")
        if not att then
            att = Instance.new("Attachment")
            att.Name = "HitboxAttachment"
            att.Parent = hrp
        end
        att.WorldPosition = Vector3.new(_G.hitboxSize, _G.hitboxSize, _G.hitboxSize)
        hrp.Size = Vector3.new(_G.hitboxSize, _G.hitboxSize, _G.hitboxSize)
        return true
    end,
    function(hrp)
        hrp:SetAttribute("HitboxSize", _G.hitboxSize)
        hrp:SetAttribute("CustomHitbox", true)
        hrp.Size = Vector3.new(_G.hitboxSize, _G.hitboxSize, _G.hitboxSize)
        return true
    end,
    function(hrp)
        local remote = game:GetService("ReplicatedStorage"):FindFirstChild("HitboxEvent") 
            or game:GetService("ReplicatedStorage"):FindFirstChild("ChangeHitbox")
            or game:GetService("ReplicatedStorage"):FindFirstChild("SetHitbox")
        if remote and remote:IsA("RemoteEvent") then
            remote:FireServer(_G.hitboxSize)
            return true
        end
        return false
    end,
    function(hrp)
        local remote = game:GetService("ReplicatedStorage"):FindFirstChild("GetHitbox")
            or game:GetService("ReplicatedStorage"):FindFirstChild("HitboxFunction")
        if remote and remote:IsA("RemoteFunction") then
            remote:InvokeServer(_G.hitboxSize)
            return true
        end
        return false
    end,
    function(hrp)
        local vel = Instance.new("BodyVelocity")
        vel.MaxForce = Vector3.new(0, 0, 0)
        vel.Velocity = Vector3.new(0, 0, 0)
        vel.Parent = hrp
        task.wait(0.05)
        vel:Destroy()
        hrp.Size = Vector3.new(_G.hitboxSize, _G.hitboxSize, _G.hitboxSize)
        return true
    end,
}

local function applyHitboxWithMethod(hrp)
    if not hrp or not _G.hitboxEnabled then return false
    
    if not hrp:GetAttribute("origSize") then
        hrp:SetAttribute("origSize", hrp.Size)
        hrp:SetAttribute("origTransparency", hrp.Transparency)
        hrp:SetAttribute("origColor", hrp.Color)
        hrp:SetAttribute("origMaterial", hrp.Material)
    end
    
    for i, method in ipairs(hitboxMethods) do
        local success, result = pcall(method, hrp)
        if success and result then
            pcall(function()
                hrp.Transparency = 0.3
                hrp.Color = _G.hitboxColor
                hrp.Material = Enum.Material.Neon
            end)
            return true
        end
    end
    
    pcall(function()
        hrp.Size = Vector3.new(_G.hitboxSize, _G.hitboxSize, _G.hitboxSize)
    end)
    return false
end

local function expandHitboxes()
    if not _G.hitboxEnabled then return end
    
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character then
            local hrp = p.Character:FindFirstChild("HumanoidRootPart")
            if hrp then
                applyHitboxWithMethod(hrp)
            end
        end
    end
end

local function resetHitboxes()
    for _, p in ipairs(Players:GetPlayers()) do
        if p.Character then
            local hrp = p.Character:FindFirstChild("HumanoidRootPart")
            if hrp then
                pcall(function()
                    local origSize = hrp:GetAttribute("origSize")
                    local origTransparency = hrp:GetAttribute("origTransparency")
                    local origColor = hrp:GetAttribute("origColor")
                    local origMaterial = hrp:GetAttribute("origMaterial")
                    
                    if origSize then hrp.Size = origSize else hrp.Size = Vector3.new(2, 2, 1) end
                    if origTransparency ~= nil then hrp.Transparency = origTransparency else hrp.Transparency = 1 end
                    if origColor then hrp.Color = origColor else hrp.Color = Color3.new(1, 1, 1) end
                    if origMaterial then hrp.Material = origMaterial else hrp.Material = Enum.Material.Plastic end
                    
                    hrp:SetAttribute("origSize", nil)
                    hrp:SetAttribute("origTransparency", nil)
                    hrp:SetAttribute("origColor", nil)
                    hrp:SetAttribute("origMaterial", nil)
                    hrp:SetAttribute("HitboxSize", nil)
                    hrp:SetAttribute("CustomHitbox", nil)
                end)
            end
        end
    end
end

local function enableHitbox()
    if _G.hitboxEnabled then return end
    _G.hitboxEnabled = true
    
    if hitboxConn then hitboxConn:Disconnect() end
    hitboxConn = addConnection(RunService.Heartbeat:Connect(function()
        expandHitboxes()
    end))
    
    expandHitboxes()
    Library:Notify({Title = "Hitbox", Description = "Hitbox включён! Размер: " .. _G.hitboxSize, Time = 3})
end

local function disableHitbox()
    if not _G.hitboxEnabled then return end
    _G.hitboxEnabled = false
    
    if hitboxConn then 
        hitboxConn:Disconnect()
        hitboxConn = nil
    end
    
    resetHitboxes()
    Library:Notify({Title = "Hitbox", Description = "Hitbox выключен!", Time = 3})
end

