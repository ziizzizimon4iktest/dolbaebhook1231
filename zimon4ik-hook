CombatSection:AddToggle({ Name = "ENABLE HITBOX", Flag = "hitbox_enabled", Callback = function(v) if v then enableHitbox() else disableHitbox() end end })
CombatSection:AddSlider({ Name = "HITBOX SIZE", Flag = "hitbox_size", Value = 10, Min = 1, Max = 30, Callback = function(v) _G.hitboxSize = v if _G.hitboxEnabled then expandHitboxes() end end })
CombatSection:AddColorpicker({ Name = "HITBOX COLOR", Flag = "hitbox_color", Value = Color3.fromRGB(255, 255, 255), Callback = function(c) _G.hitboxColor = c if _G.hitboxEnabled then expandHitboxes() end end })

-- Visuals
local VisualsSection = VisualTab:CreateSection({ Name = "ESP SETTINGS" })
VisualsSection:AddToggle({ Name = "ENABLE ESP", Flag = "esp_enabled", Callback = function(v) if v then enableESP() else disableESP() end end })
VisualsSection:AddToggle({ Name = "NAME ESP", Flag = "name_esp", Default = false, Callback = function(v) _G.nameEspEnabled = v if _G.espEnabled then updateESP() end end })
VisualsSection:AddToggle({ Name = "BOX ESP", Flag = "box_esp", Default = false, Callback = function(v) _G.boxEspEnabled = v if _G.espEnabled then updateESP() end end })
VisualsSection:AddToggle({ Name = "HEALTH BAR", Flag = "health_bar", Default = false, Callback = function(v) _G.healthBarEnabled = v if _G.espEnabled then updateESP() end end })
VisualsSection:AddColorpicker({ Name = "NAME COLOR", Flag = "name_esp_color", Value = Color3.fromRGB(255, 255, 255), Callback = function(c) _G.nameEspColor = c if _G.espEnabled then updateESP() end end })
VisualsSection:AddColorpicker({ Name = "BOX COLOR", Flag = "box_esp_color", Value = Color3.fromRGB(255, 255, 255), Callback = function(c) _G.boxEspColor = c if _G.espEnabled then updateESP() end end })

local ChamsSection = VisualTab:CreateSection({ Name = "CHAMS" })
ChamsSection:AddToggle({ Name = "ENABLE CHAMS", Flag = "chams_enabled", Callback = function(v) if v then enableChams() else disableChams() end end })
ChamsSection:AddDropdown({ Name = "CHAMS MODE", Flag = "chams_mode", List = {"Glow", "Wireframe", "Pulse"}, Value = "Glow", Callback = function(v) _G.chamsMode = v if _G.chamsEnabled then applyChams() end end })
ChamsSection:AddColorpicker({ Name = "CHAMS COLOR", Flag = "chams_color", Value = Color3.fromRGB(255, 0, 0), Callback = function(c) _G.chamsColor = c if _G.chamsEnabled then applyChams() end end })

local FogSection = VisualTab:CreateSection({ Name = "FOG" })
FogSection:AddToggle({ Name = "ENABLE FOG", Flag = "fog_enabled", Callback = function(v) _G.fogEnabled = v applyFog() end })
FogSection:AddColorpicker({ Name = "FOG COLOR", Flag = "fog_color", Value = Color3.fromRGB(255, 255, 255), Callback = function(c) _G.fogColor = c if _G.fogEnabled then applyFog() end end })
FogSection:AddButton({ Name = "RESET FOG", Callback = function() _G.fogEnabled = false _G.fogColor = Color3.fromRGB(255, 255, 255) applyFog() print("✅ Fog сброшен") end })

-- Misc
local MiscSection = MiscTab:CreateSection({ Name = "FULLBRIGHT" })
MiscSection:AddToggle({ Name = "ENABLE FULLBRIGHT", Flag = "fullbright_enabled", Callback = function(v) if v then enableFullbright() else disableFullbright() end end })
local SpeedSection = MiscTab:CreateSection({ Name = "SPEEDHACK" })
SpeedSection:AddToggle({ Name = "ENABLE SPEEDHACK", Flag = "speed_enabled", Callback = function(v) if v then enableSpeed() else disableSpeed() end end })
SpeedSection:AddSlider({ Name = "SPEED VALUE", Flag = "speed_value", Value = 30, Min = 10, Max = 60, Callback = function(v) _G.speedValue = v end })
local FovSection = MiscTab:CreateSection({ Name = "FIELD OF VIEW" })
FovSection:AddToggle({ Name = "ENABLE FOV", Flag = "fov_enabled", Callback = function(v) if v then enableFOV() else disableFOV() end end })
FovSection:AddSlider({ Name = "FOV VALUE", Flag = "fov_value", Value = 90, Min = 30, Max = 120, Callback = function(v) _G.fovValue = v if _G.fovEnabled then pcall(function() Camera.FieldOfView = v end) end end })

