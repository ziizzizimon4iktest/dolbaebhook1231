-- HITBOX
local function expandHitboxes()
    for _,p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character then
            local hrp = p.Character:FindFirstChild("HumanoidRootPart")
            if hrp then pcall(function() hrp.Size=Vector3.new(hitboxSize,hitboxSize,hitboxSize); hrp.Transparency=0.3; hrp.Color=hitboxColor; hrp.Material=Enum.Material.Neon end) end
        end
    end
end
local function resetHitboxes()
    for _,p in ipairs(Players:GetPlayers()) do
        if p.Character then local hrp=p.Character:FindFirstChild("HumanoidRootPart")
            if hrp then pcall(function() hrp.Size=Vector3.new(2,2,1); hrp.Transparency=1; hrp.Color=Color3.new(1,1,1); hrp.Material=Enum.Material.Plastic end) end
        end
    end
end
local function enableHitbox() hitboxEnabled=true; if hitboxConn then hitboxConn:Disconnect() end; hitboxConn=RunService.Heartbeat:Connect(expandHitboxes) end
local function disableHitbox() hitboxEnabled=false; if hitboxConn then hitboxConn:Disconnect(); hitboxConn=nil end; resetHitboxes() end

-- ESP
local espList = {}
local function espLoop()
    for _, item in ipairs(espList) do pcall(function() item.name:Remove() end) end
    espList = {}
    for _, p in ipairs(Players:GetPlayers()) do
        if p == LocalPlayer then continue end
        if not p.Character then continue end
        local head = p.Character:FindFirstChild("Head")
        if not head then continue end
        local txt = Drawing.new("Text")
        txt.Visible = true; txt.Color = Color3.new(1,1,1); txt.Size = 14; txt.Center = true; txt.Outline = true; txt.OutlineColor = Color3.new(0,0,0)
        table.insert(espList, {player = p, name = txt})
    end
end
local function espRender()
    local myPos = Camera.CFrame.Position
    for _, item in ipairs(espList) do
        pcall(function()
            local p = item.player
            if p == LocalPlayer then item.name.Visible = false; return end
            local char = p.Character
            if not char then item.name.Visible = false; return end
            local head = char:FindFirstChild("Head")
            if not head then item.name.Visible = false; return end
            local screenPos, onScreen = Camera:WorldToViewportPoint(head.Position + Vector3.new(0, 1.5, 0))
            if not onScreen then item.name.Visible = false; return end
            local dist = math.floor((myPos - head.Position).Magnitude)
            if dist > 1000 then item.name.Visible = false; return end
            item.name.Visible = true
            item.name.Text = p.DisplayName .. " [" .. dist .. "m]"
            item.name.Position = Vector2.new(screenPos.X, screenPos.Y)
        end)
    end
end
local function enableESP()
    espEnabled = true
    if espConn then espConn:Disconnect() end
    espLoop()
    espConn = RunService.RenderStepped:Connect(function() espLoop(); espRender() end)
end
local function disableESP()
    espEnabled = false
    if espConn then espConn:Disconnect(); espConn = nil end
    for _, item in ipairs(espList) do pcall(function() item.name:Remove() end) end
    espList = {}
end

-- SPEEDHACK
local function enableSpeed()
    speedEnabled = true
    if speedConn then speedConn:Disconnect() end
    speedConn = RunService.Heartbeat:Connect(function()
        pcall(function()
            local char = LocalPlayer.Character
            if not char then return end
            local hum = char:FindFirstChildOfClass("Humanoid")
            if not hum then return end
            if hum.MoveDirection.Magnitude > 0 then hum.WalkSpeed = speedValue else hum.WalkSpeed = 16 end
        end)
    end)
end
local function disableSpeed()
    speedEnabled = false
    if speedConn then speedConn:Disconnect(); speedConn = nil end
    pcall(function()
        local char = LocalPlayer.Character
        if char then local hum = char:FindFirstChildOfClass("Humanoid")
            if hum then hum.WalkSpeed = 16 end end
    end)
end

