-- CHAMS
-- ============================================================
local function clearChams()
    if pulseThread then pcall(function() pulseThread:Disconnect() end); pulseThread = nil end
    for _, d in ipairs(chamObjects) do
        pcall(function()
            if d.highlight then d.highlight:Destroy() end
            if d.highlight2 then d.highlight2:Destroy() end
            if d.parts then
                for _, p in ipairs(d.parts) do
                    pcall(function()
                        p.Transparency = d.origTransparency or 0
                        p.Color = d.origColor or Color3.new(1, 1, 1)
                        p.Material = d.origMaterial or Enum.Material.Plastic
                        p.Reflectance = d.origReflectance or 0
                    end)
                end
            end
        end)
    end
    chamObjects = {}
end

local function applyChams()
    clearChams()
    if not _G.chamsEnabled then return end
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr == LocalPlayer or not plr.Character then continue end
        local char = plr.Character
        local d = { player = plr, parts = {} }
        if _G.chamsMode == "Glow" then
            for _, p in ipairs(char:GetDescendants()) do
                if p:IsA("BasePart") and p.Name ~= "HumanoidRootPart" and p.Name ~= "Torso" then
                    table.insert(d.parts, p)
                    d.origTransparency = p.Transparency
                    d.origColor = p.Color
                    d.origMaterial = p.Material
                    d.origReflectance = p.Reflectance
                    p.Transparency = 0.1
                    p.Color = _G.chamsColor
                    p.Material = Enum.Material.Neon
                    p.Reflectance = 0.3
                end
            end
            local h = Instance.new("Highlight")
            h.FillColor = _G.chamsColor
            h.FillTransparency = 0.05
            h.OutlineColor = _G.chamsColor
            h.OutlineTransparency = 0
            h.Adornee = char
            h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
            h.Parent = char
            d.highlight = h
            local h2 = Instance.new("Highlight")
            h2.FillColor = _G.chamsColor
            h2.FillTransparency = 0.2
            h2.OutlineColor = _G.chamsColor
            h2.OutlineTransparency = 0.1
            h2.Adornee = char
            h2.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
            h2.Parent = char
            d.highlight2 = h2
        elseif _G.chamsMode == "Wireframe" then
            for _, p in ipairs(char:GetDescendants()) do
                if p:IsA("BasePart") and p.Name ~= "HumanoidRootPart" and p.Name ~= "Torso" then
                    table.insert(d.parts, p)
                    d.origTransparency = p.Transparency
                    d.origColor = p.Color
                    d.origMaterial = p.Material
                    p.Transparency = 0.3
                    p.Color = _G.chamsColor
                    p.Material = Enum.Material.Neon
                end
            end
            local h = Instance.new("Highlight")
            h.FillColor = _G.chamsColor
            h.FillTransparency = 0.3
            h.OutlineColor = _G.chamsColor
            h.OutlineTransparency = 0
            h.Adornee = char
            h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
            h.Parent = char
            d.highlight = h
        elseif _G.chamsMode == "Pulse" then
            for _, p in ipairs(char:GetDescendants()) do
                if p:IsA("BasePart") and p.Name ~= "HumanoidRootPart" and p.Name ~= "Torso" then
                    table.insert(d.parts, p)
                    d.origTransparency = p.Transparency
                    d.origColor = p.Color
                    d.origMaterial = p.Material
                    d.origReflectance = p.Reflectance
                    p.Color = _G.chamsColor
                    p.Material = Enum.Material.Neon
                    p.Reflectance = 0.2
                end
            end
            local h = Instance.new("Highlight")
            h.FillColor = _G.chamsColor
            h.FillTransparency = 0.1
            h.OutlineColor = _G.chamsColor
            h.OutlineTransparency = 0
            h.Adornee = char
            h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
            h.Parent = char
            d.highlight = h
            local h2 = Instance.new("Highlight")
            h2.FillColor = _G.chamsColor
            h2.FillTransparency = 0.3
            h2.OutlineColor = _G.chamsColor
            h2.OutlineTransparency = 0.1
            h2.Adornee = char
            h2.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
            h2.Parent = char
            d.highlight2 = h2
            if not pulseThread then
                pulseThread = addConnection(RunService.Heartbeat:Connect(function()
                    if not _G.chamsEnabled or _G.chamsMode ~= "Pulse" then return end
                    local pulse = 0.05 + math.sin(tick() * 4) * 0.2
                    local pulse2 = 0.15 + math.sin(tick() * 4 + 1) * 0.2
                    for _, obj in ipairs(chamObjects) do
                        if obj.parts then
                            for _, p in ipairs(obj.parts) do
                                pcall(function() p.Transparency = pulse end)
                            end
                        end
                        if obj.highlight and obj.highlight.Parent then
                            pcall(function() obj.highlight.FillTransparency = pulse2 end)
                        end
                        if obj.highlight2 and obj.highlight2.Parent then
                            pcall(function() obj.highlight2.FillTransparency = pulse2 + 0.15 end)
                        end
                    end
                end))
            end
        end
        table.insert(chamObjects, d)
    end
    print("✅ Chams: " .. _G.chamsMode)
end

local function enableChams()
    if _G.chamsEnabled then return end
    _G.chamsEnabled = true
    applyChams()
    if chamConn then chamConn:Disconnect() end
    chamConn = addConnection(Players.PlayerAdded:Connect(function()
        task.wait(1)
        if _G.chamsEnabled then applyChams() end
    end))
    print("✅ Chams включены")
end

local function disableChams()
    if not _G.chamsEnabled then return end
    _G.chamsEnabled = false
    if chamConn then chamConn:Disconnect(); chamConn = nil end
    if pulseThread then pcall(function() pulseThread:Disconnect() end); pulseThread = nil end
    clearChams()
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr.Character then
            for _, v in ipairs(plr.Character:GetDescendants()) do
                if v:IsA("Highlight") then pcall(function() v:Destroy() end) end
                if v:IsA("BasePart") and v.Material == Enum.Material.Neon then
                    pcall(function()
                        v.Transparency = 0
                        v.Material = Enum.Material.Plastic
                        v.Reflectance = 0
                    end)
                end
            end
        end
    end
    print("✅ Chams выключены")
end

