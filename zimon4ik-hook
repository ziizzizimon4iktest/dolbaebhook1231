-- HITBOX
-- ============================================================
function expandHitboxes()
    if not _G.hitboxEnabled then return end
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character then
            local hrp = p.Character:FindFirstChild("HumanoidRootPart")
            if hrp then
                pcall(function()
                    hrp.Size = Vector3.new(_G.hitboxSize, _G.hitboxSize, _G.hitboxSize)
                    hrp.Transparency = 0.3
                    hrp.Color = _G.hitboxColor
                    hrp.Material = Enum.Material.Neon
                    if not hrp:GetAttribute("origSize") then
                        hrp:SetAttribute("origSize", Vector3.new(2, 2, 1))
                        hrp:SetAttribute("origTransparency", 1)
                        hrp:SetAttribute("origColor", Color3.new(1, 1, 1))
                        hrp:SetAttribute("origMaterial", Enum.Material.Plastic)
                    end
                end)
            end
        end
    end
end

local function resetHitboxes()
    for _, p in ipairs(Players:GetPlayers()) do
        if p.Character then
            local hrp = p.Character:FindFirstChild("HumanoidRootPart")
            if hrp then
                pcall(function()
                    local origSize = hrp:GetAttribute("origSize")
                    local origTransparency = hrp:GetAttribute("origTransparency")
                    local origColor = hrp:GetAttribute("origColor")
                    local origMaterial = hrp:GetAttribute("origMaterial")
                    if origSize then hrp.Size = origSize else hrp.Size = Vector3.new(2, 2, 1) end
                    if origTransparency ~= nil then hrp.Transparency = origTransparency else hrp.Transparency = 1 end
                    if origColor then hrp.Color = origColor else hrp.Color = Color3.new(1, 1, 1) end
                    if origMaterial then hrp.Material = origMaterial else hrp.Material = Enum.Material.Plastic end
                    hrp:SetAttribute("origSize", nil)
                    hrp:SetAttribute("origTransparency", nil)
                    hrp:SetAttribute("origColor", nil)
                    hrp:SetAttribute("origMaterial", nil)
                end)
            end
        end
    end
end

local function enableHitbox()
    if _G.hitboxEnabled then return end
    _G.hitboxEnabled = true
    if hitboxConn then hitboxConn:Disconnect() end
    hitboxConn = addConnection(RunService.Heartbeat:Connect(function()
        expandHitboxes()
    end))
