-- ESP
-- ============================================================
local espObjects = {}
local espConn = nil

local function clearESP()
    for _, obj in ipairs(espObjects) do
        pcall(function() obj:Remove() end)
    end
    espObjects = {}
end

local function updateESP()
    clearESP()
    if not _G.espEnabled then return end
    
    for _, p in ipairs(Players:GetPlayers()) do
        if p == LocalPlayer or not p.Character then continue end
        
        local head = p.Character:FindFirstChild("Head")
        local hrp = p.Character:FindFirstChild("HumanoidRootPart")
        local hum = p.Character:FindFirstChildOfClass("Humanoid")
        
        if not head or not hrp or not hum then continue end
        
        if _G.nameEspEnabled then
            local txt = Drawing.new("Text")
            txt.Visible = true
            txt.Color = _G.nameEspColor
            txt.Size = 14
            txt.Center = true
            txt.Outline = true
            txt.OutlineColor = Color3.new(0, 0, 0)
            txt.Text = p.DisplayName
            table.insert(espObjects, txt)
        end
        
        if _G.boxEspEnabled then
            local box = Drawing.new("Square")
            box.Visible = true
            box.Color = _G.boxEspColor
            box.Thickness = 1
            box.Filled = false
            table.insert(espObjects, box)
        end
        
        if _G.healthBarEnabled then
            local hpBg = Drawing.new("Line")
            hpBg.Visible = true
            hpBg.Color = Color3.new(0.15, 0.15, 0.15)
            hpBg.Thickness = 3
            table.insert(espObjects, hpBg)
            
            local hpBar = Drawing.new("Line")
            hpBar.Visible = true
            hpBar.Color = Color3.new(0, 1, 0)
            hpBar.Thickness = 1
            table.insert(espObjects, hpBar)
            
            local hpText = Drawing.new("Text")
            hpText.Visible = true
            hpText.Color = Color3.new(1, 1, 1)
            hpText.Size = 10
            hpText.Center = true
            hpText.Outline = true
            hpText.OutlineColor = Color3.new(0, 0, 0)
            table.insert(espObjects, hpText)
        end
    end
end

local function renderESP()
    if not _G.espEnabled then return end
    
    local myPos = Camera.CFrame.Position
    local idx = 1
    
    for _, p in ipairs(Players:GetPlayers()) do
        if p == LocalPlayer or not p.Character then continue end
        
        local head = p.Character:FindFirstChild("Head")
        local hrp = p.Character:FindFirstChild("HumanoidRootPart")
        local hum = p.Character:FindFirstChildOfClass("Humanoid")
        
        if not head or not hrp or not hum then continue end
        
        local tp = head.Position + Vector3.new(0, 1.5, 0)
        local bp = hrp.Position - Vector3.new(0, 3.5, 0)
        local tp2, onScreen = Camera:WorldToViewportPoint(tp)
        local bp2 = Camera:WorldToViewportPoint(bp)
        
        if not onScreen then
            idx = idx + 3
            continue
        end
        
        local dist = math.floor((myPos - head.Position).Magnitude)
        if dist > 1000 then
            idx = idx + 3
            continue
        end
        
        local bh = math.abs(tp2.Y - bp2.Y)
        local bw = bh * 0.55
        local bl = tp2.X - bw / 2
        local bt = tp2.Y
        
        if _G.nameEspEnabled then
            local txt = espObjects[idx]
            if txt then
                txt.Visible = true
                txt.Color = _G.nameEspColor
                txt.Text = p.DisplayName .. " [" .. dist .. "m]"
                txt.Position = Vector2.new(tp2.X, tp2.Y - 20)
                idx = idx + 1
            end
        end
        
        if _G.boxEspEnabled then
            local box = espObjects[idx]
            if box then
                box.Visible = true
                box.Color = _G.boxEspColor
                box.Position = Vector2.new(bl, bt)
                box.Size = Vector2.new(bw, bh)
                idx = idx + 1
            end
        end
        
        if _G.healthBarEnabled then
            local hpPct = hum.Health / hum.MaxHealth
            local barX = bl - 6
            local barTY = bt
            local barBY = bt + bh
            
            local hpBg = espObjects[idx]
            if hpBg then
                hpBg.Visible = true
                hpBg.From = Vector2.new(barX, barTY)
                hpBg.To = Vector2.new(barX, barBY)
                idx = idx + 1
            end
            
            local healthY = barTY + (barBY - barTY) * (1 - hpPct)
            local hpBar = espObjects[idx]
            if hpBar then
                hpBar.Visible = true
                hpBar.From = Vector2.new(barX, healthY)
                hpBar.To = Vector2.new(barX, barBY)
                if hpPct > 0.5 then
                    hpBar.Color = Color3.new(0, 1, 0)
                elseif hpPct > 0.25 then
                    hpBar.Color = Color3.new(1, 1, 0)
                else
                    hpBar.Color = Color3.new(1, 0, 0)
                end
                idx = idx + 1
            end
            
            local hpText = espObjects[idx]
            if hpText then
                hpText.Visible = true
                hpText.Text = math.floor(hpPct * 100) .. "%"
                hpText.Position = Vector2.new(barX - 2, barTY + bh / 2)
                hpText.Color = hpPct > 0.5 and Color3.new(0, 1, 0) or (hpPct > 0.25 and Color3.new(1, 1, 0) or Color3.new(1, 0, 0))
                idx = idx + 1
            end
        end
    end
    
    for i = idx, #espObjects do
        local obj = espObjects[i]
        if obj then obj.Visible = false end
    end
end

local function enableESP()
    _G.espEnabled = true
    if espConn then espConn:Disconnect() end
    updateESP()
    espConn = addConnection(RunService.RenderStepped:Connect(function()
        updateESP()
        renderESP()
    end))
end

local function disableESP()
    _G.espEnabled = false
    if espConn then espConn:Disconnect(); espConn = nil end
    clearESP()
end

