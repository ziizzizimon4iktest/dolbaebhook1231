    if autojumpThread then pcall(function() autojumpThread:Disconnect() end); autojumpThread = nil end
    _G.fogEnabled = false
    pcall(function()
        Lighting.Fog = false
        Lighting.Technology = Enum.Technology.Future
    end)
    _G.chamsEnabled = false
    if chamConn then pcall(function() chamConn:Disconnect() end); chamConn = nil end
    if pulseThread then pcall(function() pulseThread:Disconnect() end); pulseThread = nil end
    clearChams()
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr.Character then
            for _, v in ipairs(plr.Character:GetDescendants()) do
                if v:IsA("Highlight") then pcall(function() v:Destroy() end) end
                if v:IsA("BasePart") then
                    pcall(function()
                        if v.Material == Enum.Material.Neon then
                            v.Material = Enum.Material.Plastic
                            v.Reflectance = 0
                        end
                        v.Transparency = 0
                    end)
                end
            end
        end
    end
    for _, conn in ipairs(allConnections) do
        pcall(function() if conn and conn.Disconnect then conn:Disconnect() end end)
    end
    allConnections = {}
    clearESP()
    pcall(function() if Window and Window.Remove then Window:Remove() end end)
    pcall(function()
        local gui = CoreGui:FindFirstChild("     ")
        if gui and gui:IsA("ScreenGui") then gui:Destroy() end
    end)
    _G.hitboxEnabled = false
    _G.espEnabled = false
    _G.chamsEnabled = false
    _G.fullbrightEnabled = false
    _G.speedEnabled = false
    _G.fovEnabled = false
    print("✅ Полностью выгружен!")
end

