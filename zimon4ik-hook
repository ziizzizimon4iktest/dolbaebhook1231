local function enableBlur()
    if not blur or not blur.Parent then
        blur = Instance.new("BlurEffect")
        blur.Parent = Lighting
    end
    blur.Enabled = true
    TweenService:Create(blur, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Size = 20}):Play()
end

local function disableBlur()
    if not blur then return end
    TweenService:Create(blur, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {Size = 0}):Play()
    task.delay(0.3, function()
        if blur then blur.Enabled = false end
    end)
end

local function destroyBlur()
    if blur then
        blur.Enabled = false
        pcall(function() blur:Destroy() end)
        blur = nil
    end
end

