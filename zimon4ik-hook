local function enableAutojump()
    if autojumpThread then pcall(function() autojumpThread:Disconnect() end); autojumpThread = nil end
    autojumpThread = RunService.Heartbeat:Connect(function()
        if not _G.autojumpEnabled then return end
        pcall(function()
            local char = LocalPlayer.Character
            if char then
                local hum = char:FindFirstChildOfClass("Humanoid")
                if hum and hum.PlatformStand == false then
                    if hum.FloorMaterial ~= Enum.Material.Air then
                        hum.Jump = true
                    end
                end
            end
        end)
    end)
end

-- ============================================================
-- UNINJECT
-- ============================================================
local function idealUninject()
    print("Выгрузка zimon4ik.hook v2.0...")
    
    _G.autojumpEnabled = false
    if autojumpThread then pcall(function() autojumpThread:Disconnect() end); autojumpThread = nil end
    
    disableHitbox()
    disableESP()
    disableChams()
    disableFullbright()
    disableSpeed()
    disableFOV()
    
    _G.fogEnabled = false
    pcall(function()
        Lighting.Fog = false
        Lighting.Technology = Enum.Technology.Future
    end)
    
    if chamConn then pcall(function() chamConn:Disconnect() end); chamConn = nil end
    if pulseThread then pcall(function() pulseThread:Disconnect() end); pulseThread = nil end
    clearChams()
    
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr.Character then
            for _, v in ipairs(plr.Character:GetDescendants()) do
                if v:IsA("Highlight") then pcall(function() v:Destroy() end) end
                if v:IsA("BasePart") then
                    pcall(function()
                        if v.Material == Enum.Material.Neon then
                            v.Material = Enum.Material.Plastic
                            v.Reflectance = 0
                        end
                        v.Transparency = 0
                    end)
                end
            end
        end
    end
    
    for _, conn in ipairs(allConnections) do
        pcall(function() if conn and conn.Disconnect then conn:Disconnect() end end)
    end
    allConnections = {}
    
    clearESP()
    
    Library:Unload()
    
    _G.hitboxEnabled = false
    _G.espEnabled = false
    _G.chamsEnabled = false
    _G.fullbrightEnabled = false
    _G.speedEnabled = false
    _G.fovEnabled = false
    
    print("✅ Полностью выгружен!")
end

